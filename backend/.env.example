# WebSocket Server Configuration
WS_HOST=0.0.0.0
WS_PORT=8765

# RDP Default Settings (can be overridden per-connection)
RDP_DEFAULT_WIDTH=1280
RDP_DEFAULT_HEIGHT=720

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# WebRTC: single PC with STUN + TURN, ICE picks best (host > srflx > relay), WS fallback
RTC_STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.qq.com:3478,stun:stun.chat.bilibili.com:3478
RTC_TURN_URLS=
RTC_TURN_USER=
RTC_TURN_PASS=
RTC_GATHER_TIMEOUT=5
