# WebSocket Server Configuration
WS_HOST=0.0.0.0
WS_PORT=8765

# RDP Default Settings (can be overridden per-connection)
RDP_DEFAULT_WIDTH=1280
RDP_DEFAULT_HEIGHT=720

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# WebRTC smart transport (STUN only, WS fallback on failure)
RTC_STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.l.google.com:19302
RTC_GATHER_TIMEOUT=5
